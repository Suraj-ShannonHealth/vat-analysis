generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Status {
  NEW
  REVIEWING
  APPROVED
  NOT_APPROVED
}

enum Recommendation {
  PENDING
  APPROVE
  TRIAL
  TABLE
  DENY
}

model Submission {
  id        String   @id @default(cuid())
  status    Status   @default(NEW)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Step 1 – Requestor & Item Information ──
  typeOfRequest          String
  requestedBy            String
  requestedByNameTitle   String
  requesterEmail         String
  requesterPhone         String
  requestingDepartment   String
  isNewProviderService   String
  productServiceName     String
  vendorManufacturer     String
  catalogNumber          String
  manufacturerRep        String
  productType            String

  // ── Step 2 – Product Classification ──
  productClassification  String
  isMinorEquipment       String
  capitalEquipmentInfo   String?

  // ── Step 3 – Operational (slimmed) + Product Request fields ──
  // Kept: current procedures, clinical metrics
  currentProcedures      String
  clinicalMetrics        String

  // New Product Request data points
  presenters             String?   // Presenter(s)
  teamLeads              String?   // Team Lead(s)
  purpose                String    @default("") // short purpose e.g. Cost savings and unique products
  procedures             String    @default("") // Which procedures will this be used in
  usedWith               String?   // Used with (systems/products)
  departmentsImpacted    String?   // Department(s) beyond requesting
  providersImpacted      String?   // Provider(s) / doctors impacted
  reasonsForRequest      String    @default("") // bullet-style reasons
  proposedAnnualCostImpact String  @default("") // e.g. $9,500 savings or increase
  annualUsageOld         String?   // Annual usage old product
  annualUsageNew         String?   // Annual usage new product
  replacingItems         String?   // List items that will be replaced

  // ── Step 4 – Specific Product & Usage (slimmed) ──
  governingBody          String?
  multiDepartmentUsage   String?
  anticipatedMonthlyUsage String
  specialHandling        String?
  usedWithOtherProduct   String?   // legacy; prefer usedWith

  // ── Step 5 – Financial (slimmed: ROI only) ──
  expectedRoi            String

  // ══════════════════════════════════════════
  // ADMIN / INTERNAL REVIEW
  // ══════════════════════════════════════════

  requestNumber          String?
  assignedEmployee       String?
  dateReceived           DateTime?

  // Meeting recommendation (Product Request slide)
  recommendation         Recommendation @default(PENDING)
  recommendationNotes    String?

  // Section B – Material Management
  currentCatNumber       String?
  currentLawNumber       String?
  currentVendor          String?
  currentContract        String?
  currentPricing         String?
  currentUom             String?
  currentPkg             String?
  currentEachPricing     String?
  currentVolume          String?
  currentTotalSpend      String?

  proposedCatNumber      String?
  proposedLawNumber      String?
  proposedVendor         String?
  proposedContract       String?
  proposedPricing        String?
  proposedUom            String?
  proposedPkg            String?
  proposedEachPricing    String?
  proposedVolume         String?
  proposedTotalSpend     String?

  additionalCosts        String?
  rebatesIncentives      String?
  totalCostProposed      String?
  costSavings            String?

  deptsUsingExisting     String?
  mmComments             String?

  mmAction               String?
  mmActionDate           DateTime?
  mmSpecialtyTeams       String?
  mmTargetDueDate        DateTime?
  mmDeclineReason        String?

  // Section C – VAT Review
  vatReasonForReview     String?
  vatDeptsUsing          String?
  vatTotalCostSavings    String?
  vatAction              String?
  vatActionDate          DateTime?
  vatTrialCoordinator    String?
  vatEducationCoordinator String?
  vatDenyReason          String?
  vatNotes               String?

  // Section D – Evaluation
  evalTrialCoordinator   String?
  evalPhone              String?
  evalNotes              String?
  evalAction             String?
  evalActionDate         DateTime?

  // Section E – Inventory
  inventoryLocation      String?
  purchaseUom            String?
  issueUom               String?
  majorClass             String?
  minorClass             String?
  accountGlCat           String?
  reorderPoint           String?
  reorderQty             String?
  isReplacementProduct   String?
  sohTreatment           String?

  files File[]
}

model File {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        String
  originalName String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime   @default(now())
}